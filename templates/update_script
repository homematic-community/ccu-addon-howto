#!/bin/sh
#
#   CCU addon installer template (MIT, from ccu-addon-mosquitto). The firmware
#   unpacks the archive below /usr/local/tmp, cd's into it and runs
#   ./update_script HM-RASPBERRYMATIC. Exit codes: 10 = fresh install (the
#   CCU3 firmware reboots anyway, OpenCCU reboots on 10), 0 = update
#   (OpenCCU does not reboot, so a service that was running is started here
#   again), 13 = unsupported platform. The blocks marked "ccu-addon-kit" are
#   the same as in ccu-addon-kit's update_script-reference.
#
#   Replace ADDON with your addon id everywhere.
#
#   openccu-lite.json (templates/openccu-lite.json) sits beside this script at
#   the root of the archive. openccu-lite reads it before this script runs;
#   it is not this script's business, and the CCU3 and OpenCCU ignore it.
#

ADDON=mosquitto
ADDONS_DIR=/usr/local/addons
ADDON_DIR=$ADDONS_DIR/$ADDON
CONF_DIR=/usr/local/etc/config
WWW_DIR=$CONF_DIR/addons/www/$ADDON
EXITCODE=10

# one package per architecture: refuse the wrong one (versions is written by the build)
. ./$ADDON/versions
if [ "`uname -m`" != "$ADDON_ARCH" ]; then
    echo "error: this package is for $ADDON_ARCH, this system is `uname -m`" >&2
    exit 13
fi

mount | grep /usr/local 2>&1 >/dev/null
if [ $? -eq 1 ]; then
    mount /usr/local
fi

mkdir -p $ADDONS_DIR && chmod 755 $ADDONS_DIR
mkdir -p $CONF_DIR/addons/www && chmod 755 $CONF_DIR/addons/www
mkdir -p $CONF_DIR/rc.d

# --- ccu-addon-kit: installer leftovers (update_script-reference, keep identical) ---
# The CCU3 firmware's /bin/install_addon (S00InstallAddon exists; piVCCU runs the same firmware)
# unpacks every package into a new /usr/local/tmp/tmp.XXXXXX, copies /bin, /lib, /sbin, /etc and
# /usr into it for its chroot and never removes it: one such directory per install, the size of
# the root filesystem (about 230 MB). The firmware's boot empties /usr/local/tmp, but where no
# reboot follows the install (a live install, a piVCCU container) they pile up on the user
# partition, and every backup of /usr/local carries them. So the leftovers of earlier installs go
# here, and this install's own directory at the end of this script (below), once the installer
# has released it. A directory goes only when it holds an update_script, is not this install's
# (the chroot's root or the working directory) and nothing is mounted at or below it: rm -rf
# through the installer's bind mount of /usr/local would empty the user partition (without a
# readable /proc/1/mounts nothing is removed). OpenCCU's and
# openccu-lite's installers remove their directory themselves.
KIT_TMPCLEAN='
[ -r /proc/1/mounts ] || exit 0
if [ "$1" = wait ]; then
    n=0
    while [ $n -lt 300 ] && grep -qx install_addon /proc/[0-9]*/comm 2>/dev/null; do sleep 2; n=$((n + 2)); done
fi
self=" $(stat -c %d:%i / . 2>/dev/null | tr "\n" " ") "
for d in /usr/local/tmp/tmp.*; do
    [ -d "$d" ] && [ ! -L "$d" ] && [ -f "$d/update_script" ] || continue
    case "$self" in *" $(stat -c %d:%i "$d" 2>/dev/null) "*) continue ;; esac
    cat /proc/1/mounts /proc/self/mounts 2>/dev/null | awk -v d="$d" "\$2 == d || index(\$2, d \"/\") == 1 { f = 1 } END { exit !f }" && continue
    rm -rf "$d" && logger -t "$2" "removed the installer leftover $d" 2>/dev/null
done
'
if [ -f /etc/init.d/S00InstallAddon ]; then
    sh -c "$KIT_TMPCLEAN" kit-tmpclean now $ADDON
fi
# --- end ---

# --- ccu-addon-kit: was the service running? (update_script-reference, keep identical) ---
# An update starts the service again only when it ran when this install began (below): an addon
# that ran before an update runs after it, one that was stopped stays stopped. Asked before
# anything is stopped, of the service itself: openccu-lite's unit, elsewhere the rc.d script's
# status (the service convention: exit 0 = running). The CCU3 firmware's install during the
# shutdown finds the addons already stopped (S98StartAddons stops them before S00InstallAddon
# runs), so nothing is started there and the boot starts the service.
WAS_RUNNING=0
if grep -q '^LITE=' /VERSION 2>/dev/null || [ -x /usr/bin/occulited ]; then
    systemctl is-active --quiet addon-$ADDON.service 2>/dev/null && WAS_RUNNING=1
elif [ -x $CONF_DIR/rc.d/$ADDON ]; then
    $CONF_DIR/rc.d/$ADDON status >/dev/null 2>&1 && WAS_RUNNING=1
fi
# --- end ---

# an update: stop the running service through the previous version's script
if [ -f $CONF_DIR/rc.d/$ADDON ]; then
    EXITCODE=0
    $CONF_DIR/rc.d/$ADDON stop
fi

# everything but etc/ and var/ is owned by the addon: nothing stale may survive
rm -rf $ADDON_DIR/bin $ADDON_DIR/lib $ADDON_DIR/www $ADDON_DIR/versions

cp -af $ADDON $ADDONS_DIR/
mkdir -p $ADDON_DIR/var $ADDON_DIR/etc

# migrations from older layouts of this addon go here, idempotently
# (example: fold a conf.d/ directory into one file, keep the old one as conf.d.old)

# default configuration on the first install only: on the CCU the file belongs to the user
if [ ! -f $ADDON_DIR/etc/$ADDON.conf ]; then
    cp $ADDON_DIR/etc/$ADDON.conf.default $ADDON_DIR/etc/$ADDON.conf
fi

# links: -n because busybox ln -T refuses to replace an existing directory symlink
rmdir $WWW_DIR 2> /dev/null
ln -sfn $ADDON_DIR/www $WWW_DIR
ln -sf $ADDON_DIR/bin/$ADDON-service $CONF_DIR/rc.d/$ADDON

# the Einstellungen button (templates/bin/update_addon, linked as ./update_addon in the archive)
touch $CONF_DIR/hm_addons.cfg
./update_addon $ADDON $ADDON.cfg

sync

# --- ccu-addon-kit: start it again (update_script-reference, keep identical) ---
# Only what ran before (WAS_RUNNING, above), from `cd /`: the installer deletes this script's
# directory when it returns. OpenCCU installs live and does not reboot after an update;
# openccu-lite starts the unit. The CCU3 firmware (S00InstallAddon exists) normally installs during
# the shutdown, where nothing ran, but a live install happens there as well (a self-updater
# calling /bin/install_addon, a piVCCU without the reboot after the upload) - and its installer
# runs this script in a chroot even then, in a copy of the root that is left behind afterwards.
# /proc is bound into that chroot, so /proc/1/root is the real root: the service is started there.
if [ "$WAS_RUNNING" = 1 ]; then
    cd /
    if grep -q '^LITE=' /VERSION 2>/dev/null || [ -x /usr/bin/occulited ]; then
        systemctl start addon-$ADDON.service 2>/dev/null || true
    elif [ -f /etc/init.d/S00InstallAddon ] && [ -x /proc/1/root$CONF_DIR/rc.d/$ADDON ] && command -v chroot >/dev/null 2>&1; then
        chroot /proc/1/root $CONF_DIR/rc.d/$ADDON start
    else
        $CONF_DIR/rc.d/$ADDON start
    fi
fi
# --- end ---

# --- ccu-addon-kit: the update list (update_script-reference, keep identical) ---
# After an install the system's list of addon updates is stale: OpenCCU's home page shows "Neue
# Zusatzsoftware" until its daily check (checkAddonUpdates.sh, at noon) asks the Update: URL of
# rc.d info again, and it flags any version that differs from the installed one. So the kit's
# release cache goes, and OpenCCU's check runs once the new version is in place: detached, from
# `cd /`, with no output and a few seconds later, when this script and the WebUI's request (the
# installer runs inside it) have ended. Not in the CCU3 firmware's install chroot
# (S00InstallAddon): a job started there would run in its copy of the root. openccu-lite has no
# such script.
rm -f /tmp/kit-$ADDON-release.json
if [ ! -f /etc/init.d/S00InstallAddon ] && [ -x /bin/checkAddonUpdates.sh ]; then
    (cd / && sleep 10 && [ ! -e /etc/config/NoAddonUpdateCheck ] && /bin/checkAddonUpdates.sh) >/dev/null 2>&1 </dev/null &
fi
# --- end ---

# --- ccu-addon-kit: this install's leftover (update_script-reference, keep identical) ---
# The CCU3 firmware's installer leaves this script's directory behind (above): a job on the real
# root (/proc/1/root, the chroot has /proc bound in) waits until install_addon has ended and
# unmounted, then removes it by the same rules. Nothing of the job may stay in the chroot: its
# output goes to the real root's /dev/null, as one opened through the chroot's /dev would keep
# that bind mount busy, the installer's umount would fail and the directory would stay. During
# the shutdown install the reboot may end the job first; the boot empties /usr/local/tmp there.
if [ -f /etc/init.d/S00InstallAddon ] && [ -c /proc/1/root/dev/null ] && [ -d /proc/1/root/usr/local/tmp ] && command -v chroot >/dev/null 2>&1; then
    cd /
    chroot /proc/1/root /bin/sh -c "$KIT_TMPCLEAN" kit-tmpclean wait $ADDON >/proc/1/root/dev/null 2>&1 </proc/1/root/dev/null &
fi
# --- end ---

exit $EXITCODE
